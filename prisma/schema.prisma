generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {

  id Int @id @default(autoincrement())

  personCode String @unique

  name String

  phone String

  address String?

  invoices Invoice[]

}

model Invoice {

  id Int @id @default(autoincrement())

  factor String

  sale Float

  discount Float

  createdAt DateTime @default(now())

  userId Int

  user User @relation(fields: [userId], references: [id])

}