{
  "compilerOptions": {
    "module": "commonjs",
    "rootDir": "./src",
    "ignoreDeprecations": "6.0",
    "declaration": false,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2021",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "incremental": true,
    "skipLibCheck": true,
    "strict": false
  },
  "include": ["src/**/*", "src/prisma.service.ts", "src/uploads/excel.controller.ts", "src/uploads/sales.controller.ts"],
  "exclude": ["node_modules"]
}