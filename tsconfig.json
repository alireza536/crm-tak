{
  "compilerOptions": { 
    "module": "commonjs",
    "target": "es2017",
    "moduleResolution": "node",
    "ignoreDeprecations": "6.0",

    "types": ["node"],

    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,

    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": true
  }
}