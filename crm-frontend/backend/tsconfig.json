{
  "compilerOptions": {
    "module": "commonjs",
    "rootDir": "./src",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2021",
    "sourceMap": true,
    "outDir": "./dist",
    "incremental": true,
    "skipLibCheck": true,
    "strict": false,
    "strictPropertyInitialization": false,
    
  },
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "src/seed-*.ts",
    "src/create-admin.ts",
    "src/validate-sales-import-files.ts",
    "src/sms.controller.ts",
    "src/sms.service.ts",
    "src/uploads/excel.controller.ts",
    "src/uploads/sales.controller.ts",
    "src/uploads/sales.service.ts"
  ]
}
