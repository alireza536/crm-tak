NODE_ENV=production
PORT=3001
DATABASE_URL=postgresql://crm_user:CHANGE_ME@db-host:5432/crm_production?sslmode=require
DATABASE_SSL=true
DATABASE_SSL_REJECT_UNAUTHORIZED=true
DB_POOL_MAX=10
DB_CONNECTION_TIMEOUT_MS=10000
DB_IDLE_TIMEOUT_MS=30000
JWT_SECRET=GENERATE_A_RANDOM_SECRET_WITH_AT_LEAST_64_CHARACTERS
JWT_EXPIRES_IN=8h
CORS_ORIGINS=https://yourdomain.ir,https://www.yourdomain.ir
PUBLIC_API_URL=https://api.yourdomain.ir
JSON_BODY_LIMIT=50mb
MAX_UPLOAD_BYTES=52428800
TYPEORM_SYNCHRONIZE=false
TYPEORM_MIGRATIONS_RUN=true
# Optional; only required if the SMS module is enabled.
SMS_USERNAME=
SMS_PASSWORD=
SMS_BODY_ID=
